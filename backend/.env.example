# ───────── Server ─────────
NODE_ENV=development
PORT=4000
# Comma-separated origins allowed by CORS (the admin panel is same-origin). Use * only in dev.
CORS_ORIGINS=*
LOG_LEVEL=debug

# ───────── Datastores ─────────
DATABASE_URL=postgresql://goalpulse:goalpulse@localhost:5432/goalpulse?schema=public
REDIS_URL=redis://localhost:6379

# ───────── Auth ─────────
# Production refuses placeholder secrets and secrets shorter than 32 characters.
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=30d
ADMIN_JWT_EXPIRES_IN=12h
# The first admin account is created automatically at startup if it does not exist.
# Production requires a password of 12+ characters that is not the sample value.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=ChangeMe-Now-123

# ───────── Football data provider ─────────
# sportscore  -> https://sportscore.com/developers/ (DEFAULT: free, no API key, ~10,000 requests/24 h/IP,
#                requires the visible "Powered by SportScore" link, which the mobile app shows on every screen)
# apifootball -> https://www.api-football.com (API-Sports, needs API_FOOTBALL_KEY)
# mock        -> built-in simulated matches (offline development)
FOOTBALL_PROVIDER=sportscore
SPORTSCORE_BASE_URL=https://sportscore.com
# default = curated leagues + cups + internationals (men's senior football) | all | fragments such as "premier league,iraq"
SPORTSCORE_LEAGUES=default
API_FOOTBALL_KEY=
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io

# ───────── Live engine / caching ─────────
# How often the leader instance polls the provider while matches are in play.
LIVE_POLL_INTERVAL_MS=60000
# TTL of the "today" fixture list (live scores are overlaid in real time, so this can be long).
TODAY_FIXTURES_TTL_SEC=300
# Stop live polling when the provider's remaining daily quota drops below this number.
DAILY_QUOTA_RESERVE=50
# Hard cap of provider calls per UTC day, shared by all instances (0 = off). Set it just below your plan,
# e.g. 90 on API-Football's free plan. When the cap is hit the API serves cached data.
DAILY_REQUEST_BUDGET=0
# "Starting soon" reminder lead time for followed matches.
REMINDER_MINUTES=15
# Set to false on API-only replicas when you run a dedicated worker.
RUN_WORKER=true
# Inbound API rate limit per device per minute (anonymous requests: per IP).
RATE_LIMIT_PER_MIN=120
# Reverse proxies in front of the API: Render / Railway / ALB = 1, CloudFront + ALB = 2, none = 0.
TRUST_PROXY=1
# Competitions to show and follow live: "default" (curated list), "all", or ids such as 39,140,2.
LEAGUE_IDS=default
# Max concurrent websocket connections per client IP (high on purpose: mobile carriers share IPs).
SOCKET_MAX_CONN_PER_IP=100

# ───────── Firebase Cloud Messaging (push) ─────────
# Base64 of the service-account JSON:  base64 -w0 service-account.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# ...or the raw JSON on one line (use one of the two)
FIREBASE_SERVICE_ACCOUNT_JSON=
